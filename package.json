{
  "name": "automation-exercise-playwright",
  "version": "1.0.0",
  "description": "Comprehensive test automation framework for automationexercise.com using Playwright TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:ui": "npx playwright test --ui",
    "test:report": "npx playwright show-report",
    "test:allure": "allure generate allure-results --clean && allure open",
    "test:mcp": "npx playwright test tests/MCPEnhancedTestSuite.spec.ts --project=chromium",
    "test:mcp:headed": "npx playwright test tests/MCPEnhancedTestSuite.spec.ts --project=chromium --headed",
    "test:mcp:debug": "FASTMCP_LOG_LEVEL=DEBUG npx playwright test tests/MCPEnhancedTestSuite.spec.ts",
    "test:original": "npx playwright test tests/AutomationExerciseTestSuite.spec.ts",
    "test:failures": "npx playwright test --config=playwright.failure-demo.config.ts",
    "test:failures:headed": "npx playwright test --config=playwright.failure-demo.config.ts --headed",
    "test:failures:report": "npx playwright show-report playwright-report-failures",
    "install:browsers": "npx playwright install",
    "test:chrome": "npx playwright test --project=chromium",
    "test:chrome:headed": "npx playwright test --project=chromium --headed",
    "test:firefox": "npx playwright test --project=firefox",
    "test:safari": "npx playwright test --project=webkit",
    "test:mobile": "npx playwright test --project=mobile-chrome",
    "test:parallel": "npx playwright test --workers=4",
    "test:mcp:all": "npx playwright test tests/MCPEnhancedTestSuite.spec.ts --project=chromium --project=firefox --project=webkit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "e2e"
  ],
  "author": "Test Automation Engineer",
  "license": "MIT",
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "allure-playwright": "^2.15.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {}
}
